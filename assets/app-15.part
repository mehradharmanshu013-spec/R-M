  wn=a=>{const w=a.filter(x=>x.w=="C");return w.length?"Work done: "+w.length+" · "+inr(sum(w)):""},
  sent=d.filter(x=>x.qiso),qp=d.filter(x=>!x.qiso),apr=sent.filter(x=>"DAPR".includes(x.s)),nap=sent.filter(x=>"QN".includes(x.s)),
  tpo=apr.filter(x=>x.s!="A"),nop=apr.filter(x=>x.s=="A"),
  prr=tpo.filter(x=>"DR".includes(x.s)),prn=tpo.filter(x=>x.s=="P"),
  pod=prr.filter(x=>x.s=="D"),pon=prr.filter(x=>x.s=="R"),
  cmpl=pod.filter(x=>x.w=="C"),pwp=pod.filter(x=>x.w=="W"),pns=pod.filter(x=>x.w!="C"&&x.w!="W"),
  bpr=cmpl.filter(x=>x.bs=="Processed"),bnp=cmpl.filter(x=>x.bs!="Processed"),
  pdd=bpr.filter(x=>x.pd=="Y"),npd=bpr.filter(x=>x.pd!="Y"),
