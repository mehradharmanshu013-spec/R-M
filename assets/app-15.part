 const wbn=["Paid","Billed, payment pending","Work done, not billed","Work pending / not started"],wbs=x=>x.pd=="Y"?0:x.bl?1:x.w=="C"?2:3,wb=wbn.map((n,i)=>d.filter(x=>wbs(x)===i));
