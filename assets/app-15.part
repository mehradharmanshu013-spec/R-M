"]}};
const BIL={"1": {"no": "VD/01/2026-27", "dt": "10-Nov-26", "tx": 13888, "gst": 2499.84, "tot": 16387.84, "i": [""]}};
async function pg(F,t){vf.innerHTML="<p style='text-align:center'>Loading…</p>";vw.classList.add("on");await new Promise(r=>setTimeout(r,30));
try{vf.innerHTML=(F.s||[]).map(x=>'<div class="sv">'+gz(x)+'</div>').join("")+(F.i||[]).map(x=>'<img alt="'+t+' page" src="data:image/jpeg;base64,'+x+'">').join("");vf.scrollTop=0}catch(e){vf.innerHTML="<p style='text-align:center'>Could not display this document.</p>"}}
function closeV(){vw.classList.remove("on");vf.innerHTML=""}
function openV(n){const F=FILES[n],r=D.find(x=>x.n==n);if(!F||!r)return;
const ok=Math.round(F.t)===Math.round(r.a);
$("vt").textContent=F.k+" "+F.no+" · "+F.br;
$("vc").innerHTML="Tracker: #"+r.n+" · "+r.b+" · Qtn "+r.q+" · ₹"+f(r.a)+"<br>Document total: ₹"+f(F.t)+(ok?"":" · <span class='bad'>✗ Amount does not match</span>");
pg(F,F.k)}
function chb(c){return c?c.split("&").map(x=>CHL[x]?'<button class="qb" data-c="'+x+'">'+x+'</button>':x).join(" "):""}
function openC(k){const C=CHL[k],r=C&&D.find(x=>x.n==C.n);if(!C||!r)return;
$("vt").textContent="Challan "+C.no+" · "+C.br+(C.dt?" · "+C.dt:"");
$("vc").innerHTML="Tracker: #"+r.n+" · "+r.b+" · Qtn "+r.q+" · ₹"+f(r.a)+(C.dt?"<br>Challan date: "+C.dt:"")+(C.po?(C.dt?" · ":"<br>")+"PO/PR "+C.po:"");
pg(C,"Challan")}
function bbt(b){return b?(BIL[b]?'<button class="qb" data-b="'+b+'">#'+b+'</button>':"#"+b):""}
function g2(n){return n.toLocaleString("en-IN",{minimumFractionDigits:2,maximumFractionDigits:2})}
function openB(k){const B=BIL[k];if(!B)return;const rs=D.filter(x=>x.bl==k),sa=rs.reduce((t,x)=>t+x.a,0),ok=Math.round(sa)===Math.round(B.tx);
$("vt").textContent="Tax invoice "+B.no+" · "+B.dt;
$("vc").innerHTML="Bill #"+k+" · "+rs.map(r=>r.b+" (Qtn "+r.q+")").join(", ")+"<br>Taxable ₹"+g2(B.tx)+" + GST ₹"+g2(B.gst)+" = invoice total ₹"+g2(B.tot)+(ok?"":" · <span class='bad'>✗ Taxable value does not match tracker (₹"+f(sa)+")</span>");
pg(B,"Tax invoice")}
function openA(n){const A=APR[n],r=D.find(x=>x.n==n);if(!A||!r)return;const ok=Math.round(A.t)===Math.round(r.a);
$("vt").textContent="Approval mail · "+r.b+" · approved "+r.ad;
$("vc").innerHTML="Tracker: #"+r.n+" · "+r.b+" · Qtn "+r.q+" · ₹"+f(r.a)+"<br>Approved amount: ₹"+f(A.t)+(ok?"":" · <span class='bad'>✗ Amount does not match</span>");
pg(A,"Approval mail")}
function openP(k){const P=POS[k],r=D.find(x=>x.n==P.n);if(!P||!r)return;
const all=Object.keys(POS).filter(x=>POS[x].n==P.n),tt=all.reduce((s,x)=>s+POS[x].t,0),ok=Math.round(tt)===Math.round(r.a);
$("vt").textContent="Purchase Order PO-"+k+" · "+P.br;
$("vc").innerHTML="Tracker: #"+r.n+" · "+r.b+" · Qtn "+r.q+" · ₹"+f(r.a)+"<br>This PO: ₹"+f(P.t)+(all.length>1?" · All POs ("+all.map(x=>x).join(" + ")+"): ₹"+f(tt):"")+(ok||P.x?"":" · <span class='bad'>✗ Amount does not match</span>")+(P.x?"<br>"+P.x:"");
pg(P,"PO")}
const appRoot = document.getElementById("quote-dashboard");
appRoot.addEventListener("click",e=>{const p=e.target.closest("[data-p]"),o=e.target.closest("[data-o]"),a=e.target.closest("[data-a]"),c=e.target.closest("[data-c]"),b=e.target.closest("[data-b]");if(b)openB(b.dataset.b);else if(c)openC(c.dataset.c);else if(a)openA(a.dataset.a);else if(p)openP(p.dataset.p);else if(o)openV(o.dataset.o);else if(e.target===vw)closeV()});
document.getElementById("vx").onclick=closeV;document.addEventListener("keydown",e=>{if(e.key=="Escape")closeV()});

const f=n=>Math.round(n).toLocaleString("en-IN"),inr=n=>"₹"+f(n),
  $=id=>appRoot.querySelector("#"+CSS.escape(id));
const ST={D:["PO done","--c2"],A:["Approved, no PO","--c1"],P:["Pending PO","--c4"],Q:["Pending approval","--c3"],R:["PR raised","--c6"],N:["No status","--c5"]},SK=Object.keys(ST);
const WK={C:"Completed",W:"In progress",S:"Not started","":"Not updated"};
const cv=v=>getComputedStyle(appRoot).getPropertyValue(v).trim(),col=k=>cv(ST[k][1]);
const MO={Jan:"01",Feb:"02",Mar:"03",Apr:"04",May:"05",Jun:"06",Jul:"07",Aug:"08",Sep:"09",Oct:"10",Nov:"11",Dec:"12"};
const iso=s=>{if(!s||s=="-")return"";const a=s.split("-");return MO[a[1]]?"2026-"+MO[a[1]]+"-"+a[0].padStart(2,"0"):""};
const D=raw.split("\n").map(l=>l.split("|")).map(r=>{const o={n:r[0],c:r[1],b:r[2],m:r[3],qd:r[4],q:r[5],a:+r[6],s:r[7],ap:r[8],po:r[9],w:r[10],d:r[11],ch:r[12]||"",bl:r[13]||"",bs:r[14]||"",pd:r[15]||"",ad:r[16]||""};
 o.loc=o.b.split(" ")[0].replace(/^./,x=>x.toUpperCase());o.ty=/liab/i.test(o.b)?"Liability":/asset/i.test(o.b)?"Asset":"Other";
 o.qiso=iso(o.qd);o.adiso=iso(o.ad);o.diso=o.w=="C"?iso(o.d):"";o.wl=WK[o.w]||"Not updated";return o});
const MN={Jan:"January",Feb:"February",Mar:"March",Apr:"April",May:"May",Jun:"June",Jul:"July",Aug:"August",Sep:"September",Oct:"October",Nov:"November",Dec:"December"},CM=Object.keys(MN)[new Date().getMonth()];
// Month = approval month; rows with no approval date fall into the present month
D.forEach(o=>{o.mon=o.ad?o.ad.split("-")[1]:CM;o.ord=(o.adiso?"0|"+o.adiso+"|":"1|")+String(+o.q||1e9).padStart(10,"0")+"|"+o.n.padStart(4,"0")});
let mon="";const MS=Object.keys(MN).filter(m=>D.some(r=>r.mon==m));
$("mo").innerHTML=["",...MS].map(m=>`<button class="ghost" data-m="${m}" aria-pressed="${m==""}">${m?MN[m]:"Total"}</button>`).join("");
$("mo").onclick=e=>{const b=e.target.closest("button");if(!b)return;mon=b.dataset.m;[...$("mo").children].forEach(x=>x.setAttribute("aria-pressed",x.dataset.m==mon));render()};
const uq=k=>[...new Set(D.map(d=>d[k]))].sort();
const fill=(id,l,v)=>$(id).innerHTML=`<option value="">All ${l}</option>`+v.map(x=>Array.isArray(x)?`<option value="${x[0]}">${x[1]}</option>`:`<option>${x}</option>`).join("");
fill("fStage","statuses",SK.map(k=>[k,ST[k][0]]));fill("fLoc","locations",uq("loc"));fill("fType","types",uq("ty"));fill("fWork","work",uq("wl"));
const IDS=["q","fStage","fLoc","fType","fWork","fBill","fPay","dFrom","dTo"];
IDS.forEach(i=>$(i).addEventListener("input",render));
$("reset").onclick=()=>{IDS.forEach(i=>$(i).value="");render()};
const rt=appRoot;try{const s=localStorage.getItem("th");if(s)rt.dataset.theme=s}catch(e){}
$("th").onclick=()=>{const n=(rt.dataset.theme||(matchMedia("(prefers-color-scheme:dark)").matches?"dark":"light"))=="dark"?"light":"dark";rt.dataset.theme=n;try{localStorage.setItem("th",n)}catch(e){}render()};
let sortK="ord",sortD=1,charts={};
const COLS=[["#",""],["Qtn no","q"],["Branch","b"],["Quote date","qiso"],["Amount","a","n"],["Status","s"],["Approval","ord"],["PO / PR","po"],["Work","wl"],["Challan","ch"],["Bill","bl"],["Payment","pd"],["Doc",""]];
$("thead").innerHTML="<tr>"+COLS.map(c=>`<th class="${c[2]||""}" data-k="${c[1]}">${c[0]}</th>`).join("")+"</tr>";
$("thead").onclick=e=>{const k=e.target.dataset.k;if(!k)return;sortD=sortK===k?-sortD:1;sortK=k;render()};
function filtered(){const q=$("q").value.toLowerCase(),v=i=>$(i).value;
 return D.filter(x=>{
  if(mon&&x.mon!==mon)return false;
  if(v("fStage")&&x.s!==v("fStage")||v("fLoc")&&x.loc!==v("fLoc")||v("fType")&&x.ty!==v("fType")||v("fWork")&&x.wl!==v("fWork"))return false;
  if(v("fBill")=="none"&&x.bl||v("fBill")&&v("fBill")!="none"&&x.bs!==v("fBill"))return false;
  if(v("fPay")=="Y"&&x.pd!="Y"||v("fPay")=="U"&&(!x.bl||x.pd=="Y"))return false;
  if(v("dFrom")&&(!x.qiso||x.qiso<v("dFrom"))||v("dTo")&&(!x.qiso||x.qiso>v("dTo")))return false;
  return !q||[x.b,x.q,x.po,x.c,x.loc].join(" ").toLowerCase().includes(q)})}
const sum=a=>a.reduce((t,x)=>t+x.a,0);
const kpi=(l,v,s,c)=>`<div class="card kpi" style="--k:${c}"><div class="l">${l}</div><div class="v">${v}</div><div class="s">${s}</div></div>`;
