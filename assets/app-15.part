  nb=d.filter(x=>x.s=="D"&&x.w=="C"&&!x.bl),op=d.filter(x=>"QN".includes(x.s)),bi=d.filter(x=>x.bs=="In process"),bp=d.filter(x=>x.bs=="Pending"),pu=d.filter(x=>x.bl&&x.pd!="Y"),wip=d.filter(x=>x.w=="W");
