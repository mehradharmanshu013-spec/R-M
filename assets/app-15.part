 $("kpis").innerHTML=`<div class="card"><h2>Quote pipeline</h2><div class="svw">${svt()}</div></div><div class="side">${pn("Work done after PO not required","Completed work on approved quotes where no PO is needed &middot; shown individually",nwp)}${pn("Quote pending","Quotes not yet sent to admin &middot; shown individually",qp)}${pn("Not approved","Sent to admin, waiting for approval &middot; shown individually",nap)}${pn("PR pending","PO required, PR not yet raised &middot; shown individually",prn)}${pn("Bill in process","Bill no 1 (challan 1, 2, 3, 5) &middot; shown individually",d.filter(x=>x.bl=="1"))}${pn("Work done without approval","Completed work on quotes not yet approved &middot; shown individually",nawd)}</div>`;
