    nawd=nap.filter(x=>x.w=="C"),nwp=nop.filter(x=>x.w=="C"),
  svt=()=>{const cw=pod.concat(nop),wc=cw.filter(x=>x.w=="C"),wp=cw.filter(x=>x.w=="W"),ws=cw.filter(x=>x.w!="C"&&x.w!="W"),bpd=wc.filter(x=>x.bs=="In process"),bnd=wc.filter(x=>x.bs!="In process"),pa=bpd.filter(x=>x.pd=="Y"),pp=bpd.filter(x=>x.pd!="Y"),
 X=[68,200,332],NW=126,NH=56,top=i=>10+i*82,
 N={tot:[1,0,"Total quoted",d,BL],qd:[0,1,"Quote done",sent,BL],qp:[2,1,"Quote pending",qp,Y],ap:[0,2,"Approved",apr,G],na:[1,2,"Not approved",nap,Y],por:[0,3,"PO required",tpo,G],pnr:[2,3,"PO not required",nop,Y],prr:[0,4,"PR raised",prr,G],prp:[1,4,"PR pending",prn,Y],pr:[0,5,"PO received",pod,G],pop:[1,5,"PR raised, PO pending",pon,Y],wc:[0,6,"Work completed",wc,G],wp:[1,6,"Work in progress",wp,Y],ws:[2,6,"Work not started",ws,Y],bp:[0,7,"Bill in process",bpd,G],bn:[1,7,"Bill not processed",bnd,Y],pa:[0,8,"Payment received",pa,G],pp:[1,8,"Payment pending",pp,Y]},
 E=[["tot","qd","qp"],["qd","ap","na"],["ap","por","pnr"],["por","prr","prp"],["prr","pr","pop"],["pr","wc","wp","ws"],["pnr","wc","wp","ws"],["wc","bp","bn"],["bp","pa","pp"]],
 ln=q=>`<path class="tl2" d="${q}"/>`;
 let g="";
 E.forEach(([p,...cs])=>{const A=N[p],px=X[A[0]],yb=top(A[1])+NH,my=top(N[cs[0]][1])-13,xs=[px,...cs.map(c=>X[N[c][0]])];
  g+=ln(`M${px} ${yb}V${my}M${Math.min(...xs)} ${my}H${Math.max(...xs)}`);
