  vn=n=>`<div class="vn${n.ch.length?"":" lf"}" style="--k:${n.c}"><span class="dl">${n.l}</span><span class="dv"><b>${n.a.length}</b> · ${inr(sum(n.a))}</span>${n.note?`<span class="dnote">${n.note}</span>`:""}</div>`,
  vt=t=>{let h=`<div class="vr"><div class="sp">${vn(t)}</div></div>`,n=t;while(n.ch.length){const y=n.ch[0],o=n.ch.slice(1);h+=y.l=="PO work completed"?`<div class="vr fan"><div class="sp">${vn(y)}</div><div></div><div class="sp fr">${o.map(vn).join("")}</div><i class="fl"></i><i class="fa" style="left:calc(62.5% + 12.75px)"></i><i class="fa" style="left:calc(87.5% + 4.25px)"></i></div>`:`<div class="vr"><div class="sp">${vn(y)}</div>${o.length?`<div class="vl"><i>No</i></div><div class="sp${o.length>1?" stk":""}">${o.map(vn).join("")}</div>`:""}</div>`;n=y}return h};
